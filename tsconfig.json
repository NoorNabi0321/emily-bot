{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",

    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",

    "esModuleInterop": true,

    "types": ["node"],

    "sourceMap": true,

    "strict": true,

    "isolatedModules": true,

    "skipLibCheck": true
  },

  "include": ["src/**/*"],

  "exclude": ["node_modules"]
}